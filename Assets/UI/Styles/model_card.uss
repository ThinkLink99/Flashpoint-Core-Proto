:root {
    --model-card-background-primary: rgb(0, 96, 96);
}

.model-card {
    flex-grow: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-top-right-radius: 20px;
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    flex-shrink: 0;
    flex-direction: row;
}

.model-card-header {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    -unity-background-image-tint-color: var(--model-card-background-primary);
    flex-direction: row;
    align-self: flex-end;
}

.model-card-unit-name {
    -unity-font-definition: url("project://database/Assets/Scripts/Fonts/Industry%20Test/IndustryTest-Black.otf?fileID=12800000&guid=716b5177bb4c5c242ba61635341a5efb&type=3#IndustryTest-Black");
}

.model-card-body {
    flex-direction: column;
    flex-grow: 3;
}

.model-card-unit-image {
    background-size: 100% 100%;
    flex-grow: 1;
}

.model-card-unit-stat-block {
    flex-grow: 2;
}

.model-card-unit-stat-header {
}
